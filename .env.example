# Supabase (public — safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://bxtwwvqdfikthcrodiyt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — NEVER expose to the client, never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) — generated once per environment, server-only except the public key.
# Real values belong in .env.local (gitignored) or your host's env config —
# NEVER commit real keys here. Leave these blank in the template.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Base URL of the deployed app (used in push payloads / links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
